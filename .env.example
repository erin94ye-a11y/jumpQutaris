# Server-side configuration only. Copy to .env; never put keys in browser files.
PORT=4173
# Required for Qutara AI analysis. Choose a Responses API model with structured outputs.
OPENAI_API_KEY=
QUTARA_AI_MODEL=
# Required only for U.S. Stocks or Stocks + Crypto. Uses market data endpoints, never broker orders.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Optional durable SQLite directory; the default is qutara/data.
# QUTARA_DATA_DIR=/absolute/path/to/persistent/qutara-data
